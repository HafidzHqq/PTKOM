generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FoodType {
  BELI
  MASAK
  KEDUANYA
}

enum FoodCategory {
  SARAPAN
  MAKAN_SIANG
  MAKAN_MALAM
  CAMILAN
  MINUMAN
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String?            @unique
  name                String?
  image               String?            @db.Text
  provider            String?
  providerId          String?            @map("provider_id")
  gender              String?            // "male" | "female"
  age                 Int?
  weightKg            Float?             @map("weight_kg")
  heightCm            Float?             @map("height_cm")
  activityLevel       String?            @map("activity_level") // "sedentary" | "light" | "moderate" | "active"
  dailyCalorieTarget  Int?               @map("daily_calorie_target")
  dailyProteinTarget  Int?               @map("daily_protein_target")
  dailyFatTarget      Int?               @map("daily_fat_target")
  dailyCarbTarget     Int?               @map("daily_carb_target")
  dailyFiberTarget    Int?               @map("daily_fiber_target")
  bmr                 Float?
  tdee                Float?
  monthlyFoodBudget   Int?               @map("monthly_food_budget")
  profileUpdatedAt    DateTime?          @map("profile_updated_at")
  createdAt           DateTime           @default(now()) @map("created_at")

  nutritionHistories  NutritionHistory[]

  @@map("users")
}

model NutritionHistory {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  foods     String   @db.Text
  calories  Float    @default(0)
  proteinG  Float    @default(0) @map("protein_g")
  fatG      Float    @default(0) @map("fat_g")
  carbsG    Float    @default(0) @map("carbs_g")
  fiberG    Float    @default(0) @map("fiber_g")
  loggedAt  DateTime @default(now()) @map("logged_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("nutrition_history")
}

model LocalFood {
  id                Int      @id @default(autoincrement())
  name              String
  category          String   // 'lauk', 'sayur', 'pokok', 'buah', 'paket'
  avgPriceIdr       Int      @map("avg_price_idr")
  calories          Float
  proteinG          Float    @map("protein_g")
  fatG              Float    @map("fat_g")
  carbsG            Float    @map("carbs_g")
  fiberG            Float    @map("fiber_g")
  availability      String?  // 'warteg', 'kantin', 'angkringan', 'minimarket'
  isBudgetFriendly  Boolean  @default(true) @map("is_budget_friendly")

  createdAt         DateTime @default(now()) @map("created_at")

  @@map("local_foods")
}

model Food {
  id                String         @id @default(cuid())
  name              String
  category          FoodCategory
  type              FoodType
  pricePerPortion   Float?         // Harga jika beli jadi
  portionsYielded   Int?           // Jumlah porsi jika masak sendiri
  calories          Float
  protein           Float
  carbs             Float
  fat               Float
  isHalal           Boolean        @default(true)
  isVegetarian      Boolean        @default(false)
  allergens         Json?          // MySQL doesn't support String[], using Json
  tags              Json?          // MySQL doesn't support String[], using Json
  cookTimeMinutes   Int?
  imageUrl          String?
  
  // Relations
  recipeItems       RecipeItem[]
  places            FoodPlace[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Ingredient {
  id                String         @id @default(cuid())
  name              String
  unit              String         // kg, gram, liter, butir, ikat, buah
  pricePerUnit      Float
  region            String?        // e.g., "Bandar Lampung"
  priceUpdatedAt    DateTime       @default(now())
  
  // Relations
  recipeItems       RecipeItem[]
}

model RecipeItem {
  id                String         @id @default(cuid())
  foodId            String
  ingredientId      String
  quantity          Float
  unit              String         // Unit spesifik untuk resep ini
  
  food              Food           @relation(fields: [foodId], references: [id], onDelete: Cascade)
  ingredient        Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([foodId, ingredientId])
}

model Place {
  id                String         @id @default(cuid())
  name              String
  priceRange        String         // e.g., "Rp 10.000 - Rp 25.000"
  location          String
  source            String         // warteg, restoran, kantin, delivery
  
  // Relations
  foods             FoodPlace[]
}

model FoodPlace {
  foodId            String
  placeId           String
  
  food              Food           @relation(fields: [foodId], references: [id], onDelete: Cascade)
  place             Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([foodId, placeId])
}
